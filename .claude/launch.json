{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "out",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "serve:out"
      ],
      "port": 4000,
      "autoPort": false
    }
  ]
}
