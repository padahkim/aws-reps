# dependencies
/node_modules

# next.js
/.next/
/out/

# dev 검수 도구(/_source)의 생성된 라우트 — scripts/gen-source-routes.mjs 산출물.
# 손으로 쓴 소스는 app/_source/ 에 있다 (커밋됨). predev 가 만들고 prebuild 가 지운다.
/app/%5Fsource/

# 앱 아이콘 PNG — scripts/gen-icons.mjs 가 prebuild 에서 굽는다.
# 정본은 public/icon.svg 하나다 (커밋됨). 리포에 바이너리를 두지 않으려는 것.
/public/icon-*.png

# 서비스 워커 — scripts/gen-sw.ts 가 prebuild 에서 굽는다 (원본은 scripts/sw.template.js).
# public/ 에 있어야 배포에 실리는데(빌드가 여기서 퍼 간다), 내용은 매 빌드 생성물이다.
/public/sw.js

# misc
.DS_Store
*.tsbuildinfo
next-env.d.ts
